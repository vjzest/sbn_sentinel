# SES-010: Configuration Separation
# This file serves as a template. Do NOT commit the actual .env file containing production secrets.

# Application Configuration
PROJECT_NAME="SBN Sentinel"
API_V1_STR="/api/v1"
DEBUG=False

# Security (Must be 32 bytes URL-safe base64 encoded for production Fernet encryption)
SECRET_KEY="replace-this-with-a-very-secret-and-strong-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL="sqlite:///./sbn_sentinel.db"

# SMTP Configuration (For email notifications)
SMTP_SERVER="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASSWORD="your-smtp-password"
SENDER_EMAIL="sentinel@example.com"

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Insurance Eligibility Clearinghouse Gateways (EDI 270/271)
USE_REAL_EDI_GATEWAY=false
AVAILITY_API_KEY=your_availity_api_key
CHANGE_HEALTHCARE_CLIENT_ID=your_change_healthcare_client_id
STEDI_API_KEY=your_stedi_api_key

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="JSON" # Options: JSON, TEXT
