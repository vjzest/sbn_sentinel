[flake8]
# SES-011 Coding Standards Enforcement
max-line-length = 150
exclude =
    .git,
    __pycache__,
    venv,
    env,
    build,
    dist

# Ignore specific formatting rules that conflict with modern tools like Black
extend-ignore = E203, W503

# Enforce reasonable complexity (McCabe complexity checker)
max-complexity = 15
